# Telegram Bot Token issued by @BotFather
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_BOT_TOKEN

# Comma-separated numeric Telegram User IDs allowed to operate the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=123456789,987654321

# Run Chromium headlessly in Docker/cloud environments
HEADLESS_MODE=true

# Optional HTTP/HTTPS/SOCKS5 proxy (recommended if deploying outside India and Parivahan geo-blocks requests)
# Example: http://username:password@proxy-host:8080
PROXY_URL=

# Port for the lightweight aiohttp health-check endpoint (/health)
PORT=8080
